TELEGRAM_BOT_TOKEN=
ALLOWED_USERS=
CLAUDE_MODEL=claude-opus-4-6
WORK_DIR=.
DEEPGRAM_API_KEY=
DEBUG=false
DEBOUNCE_SEC=3
MEDIA_DIR=./storage/media
LOG_DIR=./logs

# Canonical limits are calculated and rendered by the local Orchestra service.
ORCHESTRA_URL=http://127.0.0.1:8888
ORCHESTRA_ENV_FILE=/home/kesha/orchestra/.env

# Max media storage in MB — keeps files under limit, deletes oldest (>24h) first
MEDIA_MAX_MB=100

# Proxy (optional)
# HTTPS_PROXY=http://127.0.0.1:12334
# HTTP_PROXY=http://127.0.0.1:12334
# NO_PROXY=localhost,127.0.0.1
